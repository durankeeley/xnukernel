+void
+fp_setvalid(boolean_t value) {
+        thread_t	thr_act = current_thread();
+	struct x86_fx_thread_state *ifps = thr_act->machine.ifps;
+
+	if (ifps) {
+	        ifps->fp_valid = value;
+
+		if (value == TRUE) {
+			boolean_t istate = ml_set_interrupts_enabled(FALSE);
+		        clear_fpu();
+			ml_set_interrupts_enabled(istate);
+		}
+	}
+}

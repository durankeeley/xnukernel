+#ifndef UD_TYPES_H
+#define UD_TYPES_H
+
+#ifdef KERNEL
+	/* if compiling for XNU */
+#include <stdarg.h>
+#include <stdint.h>
+#include <kern/misc_protos.h>
+# ifndef __UD_STANDALONE__

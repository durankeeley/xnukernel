+            assoc = 4;
+        else if (assoc == 6)
+            assoc = 8;
+        else if (assoc == 8)
+            assoc = 16;
+        else if (assoc == 10)
+            assoc = 32;
+        else if (assoc == 11)
+            assoc = 48;
+        else if (assoc == 12)

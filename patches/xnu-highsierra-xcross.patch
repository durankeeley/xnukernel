+/* AnV: AMD TLB Fix */
+void
+FixAMDTLB(void)
+{
+    uint64_t value = 0;
+    
+    // re-enable TLB caching if BIOS disabled it
+    // MSR_K8_HWCR mod
+    value = rdmsr64(0xC0010015);
+    value &= ~(1UL << 3);
+    wrmsr64(0xC0010015, value);
+    
+    // MSR_C0011023 mod
+    value = rdmsr64(0xC0011023);
+    value &= ~(1UL << 1);
+    wrmsr64(0xC0011023, value);
+}
 

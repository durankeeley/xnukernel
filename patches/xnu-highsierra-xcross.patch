+            (uint32_t)(tscFreq % Mega), 
+            (uint32_t)(tscFCvtt2n >> 32), (uint32_t)tscFCvtt2n,
+            (uint32_t)(tscFCvtn2t >> 32), (uint32_t)tscFCvtn2t,
+            tscGranularity, N_by_2_bus_ratio ? " (N/2)" : "");
+}

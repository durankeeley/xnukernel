diff --git a/src/xnu/osfmk/OPEMU/opemu_avx_glue.c b/src/xnu/osfmk/OPEMU/opemu_avx_glue.c
new file mode 100644
index 0000000..9bfa27f
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/opemu_avx_glue.c
@@ -0,0 +1,119 @@
+/**
+ * Kernel glue for the AVX engine: called from the #UD handlers (opemu_utrap / opemu_ktrap) before the generic decoder.
+ * It snapshots the XMM registers (live in the CPU), joins them with the per-thread shadow of the upper YMM halves, runs avx_exec() and
+ * writes the result back (XMM, shadow, GPRs, arithmetic RFLAGS, RIP). K8/K10 have no XSAVE, so the kernel never saves YMM state itself: the
+ * shadow lives in struct machine_thread (opemu_ymmh[0] for user code, [1] for kernel code, so a kext using AVX cannot corrupt user state).
+ *
+ * STATUS
+ *  . 64-bit user and kernel code; 32-bit processes are not handled (C4/C5 are LES/LDS there).
+ *  . A failed user memory access returns 0 and ends up as SIGILL instead of a page fault.
+ *  . Unsupported instructions are logged (first 200) with their bytes so the missing form can be added.
+ *  . The shadow is not copied on fork/thread_dup: a child starts with zero upper halves.
+ *
+ * HISTORY
+ *  . XCROSS   New for the Tahoe AVX engine
+ */
+#include <stdint.h>
+#include <string.h>
+#include <i386/trap.h>
+#include <i386/thread.h>
+#include <kern/thread.h>
+#include <kern/misc_protos.h>
+#include "opemu.h"
+#include "opemu_avx.h"
+
+
+struct avx_ref { int ring0; };
+
+static int
+k_rd(void *u, uint64_t a, void *d, size_t n)
+{
+	if (((struct avx_ref *)u)->ring0) { memcpy(d, (const void *)(uintptr_t)a, n); return 0; }
+	return copyin(a, (char *)d, n) ? -1 : 0;
+}
+
+static int
+k_wr(void *u, uint64_t a, const void *s, size_t n)
+{
+	if (((struct avx_ref *)u)->ring0) { memcpy((void *)(uintptr_t)a, s, n); return 0; }
+	return copyout(s, a, n) ? -1 : 0;
+}
+
+static uint64_t avx_hits, avx_fail;
+
+/* returns 1 if the instruction was emulated (RIP advanced), 0 if it is not a VEX instruction / not supported */
+int
+opemu_avx_try(x86_saved_state_t *state, int ring0)
+{
+	if (!is_saved_state64(state)) {
+		return 0;
+	}
+	x86_saved_state64_t *ss = saved_state64(state);
+	uint8_t code[32];
+	memset(code, 0, sizeof code);
+	if (ring0) {
+		memcpy(code, (const void *)(uintptr_t)ss->isf.rip, 16);
+	} else if (copyin(ss->isf.rip, (char *)code, 16) != 0) {
+		/* near the end of a mapping: try a shorter read */
+		if (copyin(ss->isf.rip, (char *)code, 8) != 0) {
+			return 0;
+		}
+	}
+	{
+		/* VEX (C4/C5), or legacy MOVBE: [66] [REX] 0F 38 F0/F1 */
+		unsigned k = 0;
+		while (code[k] == 0x66 && k < 4) k++;
+		if ((code[k] & 0xF0) == 0x40) k++;
+		int movbe = code[k] == 0x0F && code[k + 1] == 0x38 && (code[k + 2] == 0xF0 || code[k + 2] == 0xF1);
+		if (code[0] != 0xC4 && code[0] != 0xC5 && !movbe) {
+			return 0;
+		}
+	}
+
+	thread_t th = current_thread();
+	uint8_t *hi = th->machine.opemu_ymmh[ring0 ? 1 : 0];
+	uint8_t xs[256] __attribute__((aligned(16)));
+	avx_ctx_t c;
+	struct avx_ref ref = { ring0 };
+
+	opemu_xmm_save(xs);
+	for (int i = 0; i < 16; i++) {
+		memcpy(c.y[i], xs + 16 * i, 16);
+		memcpy(c.y[i] + 16, hi + 16 * i, 16);
+	}
+	c.g[0] = ss->rax; c.g[1] = ss->rcx; c.g[2] = ss->rdx; c.g[3] = ss->rbx; c.g[4] = ss->isf.rsp; c.g[5] = ss->rbp; c.g[6] = ss->rsi; c.g[7] = ss->rdi;
+	c.g[8] = ss->r8; c.g[9] = ss->r9; c.g[10] = ss->r10; c.g[11] = ss->r11; c.g[12] = ss->r12; c.g[13] = ss->r13; c.g[14] = ss->r14; c.g[15] = ss->r15;
+	c.rflags = ss->isf.rflags;
+	c.rip = ss->isf.rip;
+	__asm__ __volatile__("stmxcsr %0" : "=m"(c.mxcsr));
+	c.mxcsr_dirty = 0;
+	c.is64 = 1;
+	c.user = &ref; c.rd = k_rd; c.wr = k_wr;
+
+	unsigned len = 0;
+	int rc = avx_exec(&c, code, &len);
+	if (rc != AVX_OK) {
+		opemu_xmm_restore(xs);
+		avx_fail++;
+		if (avx_fail <= 200) {
+			printf("OPEMU-AVX: unsupported (rc=%d) rip=%llx bytes=%02x %02x %02x %02x %02x %02x %02x %02x %02x\n", rc, ss->isf.rip,
+			    code[0], code[1], code[2], code[3], code[4], code[5], code[6], code[7], code[8]);
+		}
+		return 0;
+	}
+	for (int i = 0; i < 16; i++) {
+		memcpy(xs + 16 * i, c.y[i], 16);
+		memcpy(hi + 16 * i, c.y[i] + 16, 16);
+	}
+	opemu_xmm_restore(xs);
+	if (c.mxcsr_dirty) {
+		uint32_t m = c.mxcsr & 0xFFBF;      /* DAZ (bit 6) is not supported by every K8 */
+		__asm__ __volatile__("ldmxcsr %0" : : "m"(m));
+	}
+	ss->rax = c.g[0]; ss->rcx = c.g[1]; ss->rdx = c.g[2]; ss->rbx = c.g[3]; ss->isf.rsp = c.g[4]; ss->rbp = c.g[5]; ss->rsi = c.g[6]; ss->rdi = c.g[7];
+	ss->r8 = c.g[8]; ss->r9 = c.g[9]; ss->r10 = c.g[10]; ss->r11 = c.g[11]; ss->r12 = c.g[12]; ss->r13 = c.g[13]; ss->r14 = c.g[14]; ss->r15 = c.g[15];
+	ss->isf.rflags = (ss->isf.rflags & ~(uint64_t)0x8D5) | (c.rflags & 0x8D5);
+	ss->isf.rip += len;
+	avx_hits++;
+	return 1;
+}
diff --git a/src/xnu/osfmk/OPEMU/opemu_fast.c b/src/xnu/osfmk/OPEMU/opemu_fast.c
new file mode 100644
index 0000000..7124cdc
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/opemu_fast.c
@@ -0,0 +1,125 @@
+/*
+ * OPEMU fast path for PSHUFB and PALIGNR (SSE form, 64-bit mode).
+ *
+ * xcross: macOS 10.13's memmove/memcpy uses these two instructions unconditionally, so a CPU without SSSE3 (AMD K8/K10)
+ * traps on them constantly (>99% of all emulated instructions). The generic path (libudis86 decode, generic dispatcher,
+ * operand structs) is far too heavy for that, so this file decodes just these encodings by hand and computes on 64-bit
+ * words. Anything it does not recognise returns 0 and falls back to the generic path, so behaviour is unchanged.
+ *
+ *   66 [REX] 0F 38 00 /r         PSHUFB  xmm1, xmm2/m128
+ *   66 [REX] 0F 3A 0F /r ib      PALIGNR xmm1, xmm2/m128, imm8
+ *
+ * The user's XMM registers are live while we run; we only read the two operands and write the destination, and this code
+ * is compiled without implicit vector use (-mno-implicit-float), so nothing else is disturbed.
+ 
+ *
+ * STATUS
+ *  . PSHUFB and PALIGNR (SSE form, register and memory source) in 64-bit mode, user and kernel; anything else falls back to the generic path.
+ *  . Checked by scripts/opemu-hosttest.sh (ht_fast.c).
+ *
+ * HISTORY
+ *  . XCROSS   New: macOS memmove/memcpy uses these two instructions unconditionally, so they are >99% of all traps on K8/K10
+ */
+#include <stdint.h>
+#include <string.h>
+#include <kern/misc_protos.h>
+#include "opemu.h"
+#include "ssse3_priv.h"
+
+static inline uint64_t *
+gpr(x86_saved_state64_t *s, int i)
+{
+	switch (i) {
+	case 0: return &s->rax;  case 1: return &s->rcx;  case 2: return &s->rdx;  case 3: return &s->rbx;
+	case 4: return &s->isf.rsp; case 5: return &s->rbp; case 6: return &s->rsi; case 7: return &s->rdi;
+	case 8: return &s->r8;   case 9: return &s->r9;   case 10: return &s->r10; case 11: return &s->r11;
+	case 12: return &s->r12; case 13: return &s->r13; case 14: return &s->r14; default: return &s->r15;
+	}
+}
+
+static inline void
+pshufb16(const uint64_t *d, const uint64_t *c, uint64_t *out)
+{
+	const uint8_t *data = (const uint8_t *)d, *ctl = (const uint8_t *)c;
+	uint8_t r[16];
+	for (int i = 0; i < 16; i++)
+		r[i] = (ctl[i] & 0x80) ? 0 : data[ctl[i] & 15];
+	memcpy(out, r, 16);
+}
+
+/* (dst:src) >> (imm * 8), 128 bits of result; imm >= 32 gives zero */
+static inline void
+palignr16(const uint64_t *d, const uint64_t *s, unsigned imm, uint64_t *out)
+{
+	uint64_t w[6];
+	unsigned q, rem;
+	if (imm >= 32) { out[0] = out[1] = 0; return; }
+	w[0] = s[0]; w[1] = s[1]; w[2] = d[0]; w[3] = d[1]; w[4] = w[5] = 0;
+	q = imm >> 3; rem = (imm & 7) * 8;
+	if (rem) {
+		out[0] = (w[q] >> rem) | (w[q + 1] << (64 - rem));
+		out[1] = (w[q + 1] >> rem) | (w[q + 2] << (64 - rem));
+	} else {
+		out[0] = w[q]; out[1] = w[q + 1];
+	}
+}
+
+int
+opemu_fast(const uint8_t *code, x86_saved_state64_t *ss, int ring0)
+{
+	unsigned i = 0, rex = 0, modrm, mod, rm, reg, imm = 0;
+	int is_palignr;
+	uint64_t d[2], s[2], r[2];
+
+	if (code[i] != 0x66) return 0;			/* the MMX forms and everything unusual: generic path */
+	i++;
+	if ((code[i] & 0xf0) == 0x40) rex = code[i++];
+	if (code[i++] != 0x0f) return 0;
+	if (code[i] == 0x38) { if (code[i + 1] != 0x00) return 0; is_palignr = 0; }
+	else if (code[i] == 0x3a) { if (code[i + 1] != 0x0f) return 0; is_palignr = 1; }
+	else return 0;
+	i += 2;
+
+	modrm = code[i++];
+	mod = modrm >> 6; rm = modrm & 7;
+	reg = ((modrm >> 3) & 7) | ((rex & 4) << 1);
+
+	if (!opemu_ssse3_enabled())
+		return 0;
+
+	if (mod == 3) {
+		if (is_palignr) imm = code[i++];
+		_store_xmm(rm | ((rex & 1) << 3), (__uint128_t *)s);
+	} else {
+		uint64_t ea = 0;
+		int64_t disp = 0;
+		unsigned base = rm | ((rex & 1) << 3);
+		int has_base = 1, rip_rel = 0;
+
+		if (rm == 4) {					/* SIB */
+			unsigned sib = code[i++], idx = ((sib >> 3) & 7) | ((rex & 2) << 2);
+			base = (sib & 7) | ((rex & 1) << 3);
+			if (idx != 4) ea = *gpr(ss, idx) << (sib >> 6);	/* index 4 (rsp) without REX.X means none */
+			if ((sib & 7) == 5 && mod == 0) { has_base = 0; disp = (int32_t)(code[i] | code[i + 1] << 8 | code[i + 2] << 16 | (uint32_t)code[i + 3] << 24); i += 4; }
+		} else if (rm == 5 && mod == 0) {		/* RIP-relative */
+			has_base = 0; rip_rel = 1;
+			disp = (int32_t)(code[i] | code[i + 1] << 8 | code[i + 2] << 16 | (uint32_t)code[i + 3] << 24); i += 4;
+		}
+		if (mod == 1) disp = (int8_t)code[i++];
+		else if (mod == 2) { disp = (int32_t)(code[i] | code[i + 1] << 8 | code[i + 2] << 16 | (uint32_t)code[i + 3] << 24); i += 4; }
+		if (is_palignr) imm = code[i++];
+
+		if (has_base) ea += *gpr(ss, base);
+		if (rip_rel) ea += ss->isf.rip + i;		/* relative to the end of the instruction */
+		ea += (uint64_t)disp;
+		if (ring0) memcpy(s, (const void *)(uintptr_t)ea, 16);
+		else if (copyin(ea, (char *)s, 16) != 0) return 0;
+	}
+
+	_store_xmm(reg, (__uint128_t *)d);
+	if (is_palignr) palignr16(d, s, imm, r);
+	else pshufb16(d, s, r);
+	_load_xmm(reg, (const __uint128_t *)r);
+	opemu_ssse3_hit(is_palignr);
+	return (int)i;
+}
diff --git a/src/xnu/osfmk/OPEMU/opemu_math.c b/src/xnu/osfmk/OPEMU/opemu_math.c
new file mode 100644
index 0000000..bcfb7dd
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/opemu_math.c
@@ -0,0 +1,151 @@
+/**
+ * Small freestanding math helpers (truncf, floorf, ceilf, ...) for the SSE emulation routines: the kernel has no libm.
+ *
+ * STATUS
+ *  . Used by sse3.c and sse41.c; checked indirectly by the host test (scripts/opemu-hosttest.sh).
+ *
+ * HISTORY
+ *  . SINETEK  Original helpers
+ *  . XCROSS   Host-tested through the instructions that use them
+ */
+
+#include <stdint.h>
+#include "opemu_math.h"
+
+/* 32-bit */
+float opemu_truncf(float x)
+{
+    float ret = x;
+    int32_t signbit=0;
+    int32_t w=0;
+    int32_t exponent_less_127=0;
+    
+    GET_FLOAT_WORD(w,ret);
+    
+    /* Extract sign bit. */
+    signbit = w & 0x80000000;
+    
+    /* Extract exponent field. */
+    exponent_less_127 = ((w & 0x7f800000) >> 23) - 127;
+    
+    if (exponent_less_127 < 23)
+    {
+        if (exponent_less_127 < 0)
+        {
+            /* -1 < x < 1, so result is +0 or -0. */
+            SET_FLOAT_WORD(ret, signbit);
+        }
+        else
+        {
+            SET_FLOAT_WORD(ret, signbit | (w & ~(0x007fffff >> exponent_less_127)));
+        }
+    }
+    else
+    {
+        if (exponent_less_127 == 255)
+        /* x is NaN or infinite. */
+            return ret + ret;
+        
+        /* All bits in the fraction field are relevant. */
+    }
+    return ret;
+}
+
+/* 64-bit */
+double opemu_trunc(double x)
+{
+    double ret = x;
+    int signbit=0;
+    /* Most significant word, least significant word. */
+    int msw=0;
+    unsigned int lsw=0;
+    int exponent_less_1023=0;
+    
+    EXTRACT_WORDS(msw, lsw, ret);
+    
+    /* Extract sign bit. */
+    signbit = msw & 0x80000000;
+    
+    /* Extract exponent field. */
+    exponent_less_1023 = ((msw & 0x7ff00000) >> 20) - 1023;
+    
+    if (exponent_less_1023 < 20)
+    {
+        /* All significant digits are in msw. */
+        if (exponent_less_1023 < 0)
+        {
+            /* -1 < x < 1, so result is +0 or -0. */
+            INSERT_WORDS(ret, signbit, 0);
+        }
+        else
+        {
+            /* All relevant fraction bits are in msw, so lsw of the result is 0. */
+            INSERT_WORDS(ret, signbit | (msw & ~(0x000fffff >> exponent_less_1023)), 0);
+        }
+    }
+    else if (exponent_less_1023 > 51)
+    {
+        if (exponent_less_1023 == 1024)
+        {
+            /* x is infinite, or not a number, so trigger an exception. */
+            return ret + ret;
+        }
+        /* All bits in the fraction fields of the msw and lsw are needed in the result. */
+    }
+    else
+    {
+        /* All fraction bits in msw are relevant.  Truncate irrelevant
+         bits from lsw. */
+        INSERT_WORDS(ret, msw, lsw & ~(0xffffffffu >> (exponent_less_1023 - 20)));
+    }
+    return ret;
+}
+
+/* 128-bit */
+long double opemu_truncl(long double x)
+{
+    long double ret = x;
+    uint64_t signbit;
+    /* Most significant word, least significant word. */
+    uint64_t msw=0;
+    uint64_t lsw=0;
+    int32_t exponent_less_16383=0;
+    
+    GET_LDOUBLE_WORDS(msw, lsw, ret);
+    
+    /* Extract sign bit. */
+    signbit = msw & 0x8000000000000000ULL;
+    
+    /* Extract exponent field. */
+    exponent_less_16383 = ((msw & 0x7fff000000000000ULL) >> 48) - 16383;
+    
+    if (exponent_less_16383 < 48)
+    {
+        /* All significant digits are in msw. */
+        if (exponent_less_16383 < 0)
+        {
+            /* -1 < x < 1, so result is +0 or -0. */
+            SET_LDOUBLE_WORDS(ret, signbit, 0);
+        } else {
+            /* All relevant fraction bits are in msw, so lsw of the result is 0. */
+            SET_LDOUBLE_WORDS(ret, msw & ~(0x0000ffffffffffffLL >> exponent_less_16383), 0);
+        }
+    }
+    else if (exponent_less_16383 > 111)
+    {
+        if (exponent_less_16383 == 16384)
+        {
+            /* x is infinite, or not a number, so trigger an exception. */
+            return ret + ret;
+        }
+        /* All bits in the fraction fields of the msw and lsw are needed in the result. */
+    }
+    else
+    {
+        /* All fraction bits in msw are relevant.  Truncate irrelevant
+         bits from lsw. */
+        SET_LDOUBLE_WORDS(ret, msw, lsw & ~(0xffffffffffffffffULL >> (exponent_less_16383 - 48)));
+    }
+    
+    return ret;
+}
diff --git a/src/xnu/osfmk/OPEMU/opemu_math.h b/src/xnu/osfmk/OPEMU/opemu_math.h
new file mode 100644
index 0000000..39fcb89
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/opemu_math.h
@@ -0,0 +1,79 @@
+/* Needed unions */
+typedef union
+{
+    float value;
+    uint32_t word;
+} ieee_float_shape_type;
+
+typedef union
+{
+    double value;
+    struct
+    {
+        uint32_t lsw;
+        uint32_t msw;
+    } parts;
+} ieee_double_shape_type;
+
+typedef union
+{
+    long double value;
+    struct
+    {
+        uint64_t lsw;
+        uint64_t msw;
+    } parts;
+} ieee_long_double_shape_type;
+
+/* 32-bit (float) */
+#define GET_FLOAT_WORD(i,d) \
+  do { \
+    ieee_float_shape_type gf_u; \
+    gf_u.value = (d); \
+    (i) = gf_u.word; \
+  } while (0)
+
+#define SET_FLOAT_WORD(d,i) \
+  do { \
+    ieee_float_shape_type sf_u; \
+    sf_u.word = (i); \
+    (d) = sf_u.value; \
+  } while (0)
+
+/* 64-bit (double) */
+#define EXTRACT_WORDS(ix0,ix1,d) \
+  do { \
+    ieee_double_shape_type ew_u; \
+    ew_u.value = (d); \
+    (ix0) = ew_u.parts.msw; \
+    (ix1) = ew_u.parts.lsw; \
+  } while (0)
+
+#define INSERT_WORDS(d,ix0,ix1) \
+  do { \
+    ieee_double_shape_type iw_u; \
+    iw_u.parts.msw = (ix0); \
+    iw_u.parts.lsw = (ix1); \
+    (d) = iw_u.value; \
+  } while (0)
+
+/* 128-bit (long double) */
+#define GET_LDOUBLE_WORDS(ix0,ix1,d) \
+  do { \
+    ieee_long_double_shape_type qw_u; \
+    qw_u.value = (d); \
+    (ix0) = qw_u.parts.msw; \
+    (ix1) = qw_u.parts.lsw; \
+  } while (0)
+
+#define SET_LDOUBLE_WORDS(d,ix0,ix1) \
+  do { \
+    ieee_long_double_shape_type qw_u; \
+    qw_u.parts.msw = (ix0); \
+    qw_u.parts.lsw = (ix1); \
+    (d) = qw_u.value; \
+  } while (0)
+
+float opemu_truncf(float x);
+double opemu_trunc(double x);
+long double opemu_truncl(long double x);
diff --git a/src/xnu/osfmk/OPEMU/opemu_policy.c b/src/xnu/osfmk/OPEMU/opemu_policy.c
new file mode 100644
index 0000000..6d738c8
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/opemu_policy.c
@@ -0,0 +1,157 @@
+/*
+ * OPEMU policy: decide which instruction sets the opcode emulator may emulate.
+ *
+ * Default ("auto"): emulate an instruction set only if the CPU itself reports (CPUID) that it lacks it.
+ * If the CPU does have it, a #UD for such an instruction is a genuine bad opcode and is not emulated.
+ *
+ * Boot-args (value 0 = never emulate, 1 = always emulate, 2 = auto, the default):
+ *   opemu=<n>          default for every set
+ *   opemu_sse3=<n>  opemu_ssse3=<n>  opemu_sse41=<n>  opemu_sse42=<n>     per-set override
+ *   opemu_log=1        print each set the first time it is used, and a running count
+ * Example: a hypervisor that passes SSSE3 through natively  ->  opemu_ssse3=0
+ 
+ *
+ * STATUS
+ *  . Policy per instruction set (SSE3, SSSE3, SSE4.1, SSE4.2) with boot-args opemu, opemu_<set>, opemu_log; counters and rate-limited logging.
+ *  . AVX/BMI/FMA are not subject to this policy: they are emulated whenever the CPU raises #UD for a VEX opcode.
+ *
+ * HISTORY
+ *  . XCROSS   New: without it a hypervisor that runs SSSE3 natively could not turn the emulator off for that set
+ */
+#include <stdint.h>
+#include <string.h>
+#include <i386/cpuid.h>
+#include <pexpert/pexpert.h>
+#include <kern/misc_protos.h>
+
+#include "opemu.h"
+
+enum { OPEMU_OFF = 0, OPEMU_ON = 1, OPEMU_AUTO = 2 };
+enum { OPC_SSE3, OPC_SSSE3, OPC_SSE41, OPC_SSE42, OPC_COUNT };
+
+static const char *const opc_name[OPC_COUNT] = { "sse3", "ssse3", "sse41", "sse42" };
+static const char *const opc_arg[OPC_COUNT]  = { "opemu_sse3", "opemu_ssse3", "opemu_sse41", "opemu_sse42" };
+static const uint32_t     opc_ecx_bit[OPC_COUNT] = { 1u << 0, 1u << 9, 1u << 19, 1u << 20 };
+
+static int      opc_mode[OPC_COUNT];
+static int      opc_hw[OPC_COUNT];
+static int      opc_emulate[OPC_COUNT];
+static uint32_t opc_hits[OPC_COUNT];
+static uint32_t opemu_log;
+static volatile int policy_ready;
+
+static const char *const list_sse3[] = {
+	"addsubpd", "addsubps", "haddpd", "haddps", "hsubpd", "hsubps", "lddqu", "movddup",
+	"movshdup", "movsldup", "fisttp", "fistp", "mwait", "monitor", NULL };
+static const char *const list_ssse3[] = {
+	"pshufb", "phaddw", "phaddd", "phaddsw", "phsubw", "phsubd", "phsubsw", "pmaddubsw",
+	"pmulhrsw", "psignb", "psignw", "psignd", "pabsb", "pabsw", "pabsd", "palignr", NULL };
+static const char *const list_sse41[] = {
+	"pblendw", "blendps", "blendpd", "blendvps", "blendvpd", "pblendvb", "pextrb", "pextrd",
+	"pextrq", "pinsrb", "pinsrd", "pinsrq", "extractps", "insertps", "ptest", "pminsb",
+	"pminsd", "pminuw", "pminud", "pmaxsb", "pmaxsd", "pmaxuw", "pmaxud", "pmulld", "pmuldq",
+	"pcmpeqq", "packusdw", "pmovsxbw", "pmovsxbd", "pmovsxbq", "pmovsxwd", "pmovsxwq",
+	"pmovsxdq", "pmovzxbw", "pmovzxbd", "pmovzxbq", "pmovzxwd", "pmovzxwq", "pmovzxdq",
+	"roundps", "roundpd", "roundss", "roundsd", "dpps", "dppd", "mpsadbw", "phminposuw",
+	"movntdqa", NULL };
+static const char *const list_sse42[] = {
+	"pcmpestri", "pcmpestrm", "pcmpistri", "pcmpistrm", "pcmpgtq", "crc32", "popcnt", NULL };
+static const char *const *const opc_list[OPC_COUNT] = { list_sse3, list_ssse3, list_sse41, list_sse42 };
+
+static int
+in_list(const char *const *l, const char *name)
+{
+	for (; *l; l++)
+		if (strcmp(*l, name) == 0)
+			return 1;
+	return 0;
+}
+
+/* classification is by mnemonic name, which is slow: cache it per mnemonic (0 = not yet classified, else class + 2) */
+static int8_t cls_cache[1024];
+
+static int
+opemu_classify(uint32_t mnemonic)
+{
+	const char *name;
+	int c, found = -1;
+
+	if (mnemonic < sizeof cls_cache && cls_cache[mnemonic])
+		return cls_cache[mnemonic] - 2;
+
+	name = ud_lookup_mnemonic((enum ud_mnemonic_code)mnemonic);
+	if (name) {
+		for (c = 0; c < OPC_COUNT; c++)
+			if (in_list(opc_list[c], name)) { found = c; break; }
+	}
+	if (mnemonic < sizeof cls_cache)
+		cls_cache[mnemonic] = (int8_t)(found + 2);
+	return found;	/* -1: not an extension instruction, never gated */
+}
+
+static void
+opemu_policy_init(void)
+{
+	uint32_t reg[4];
+	uint32_t def = OPEMU_AUTO, v;
+
+	if (PE_parse_boot_argn("opemu", &v, sizeof(v)) && v <= OPEMU_AUTO)
+		def = v;
+	if (!PE_parse_boot_argn("opemu_log", &opemu_log, sizeof(opemu_log)))
+		opemu_log = 0;
+
+	do_cpuid(1, reg);	/* raw CPUID: what the silicon (or hypervisor) really advertises */
+
+	for (int c = 0; c < OPC_COUNT; c++) {
+		opc_mode[c] = def;
+		if (PE_parse_boot_argn(opc_arg[c], &v, sizeof(v)) && v <= OPEMU_AUTO)
+			opc_mode[c] = v;
+		opc_hw[c] = (reg[ecx] & opc_ecx_bit[c]) ? 1 : 0;
+		opc_emulate[c] = (opc_mode[c] == OPEMU_ON) || (opc_mode[c] == OPEMU_AUTO && !opc_hw[c]);
+		printf("OPEMU: %-5s mode=%s cpu=%s -> %s\n", opc_name[c],
+		    opc_mode[c] == OPEMU_ON ? "on" : opc_mode[c] == OPEMU_OFF ? "off" : "auto",
+		    opc_hw[c] ? "has" : "lacks",
+		    opc_emulate[c] ? "EMULATE" : "do not emulate");
+	}
+	policy_ready = 1;
+}
+
+/* Returns 1 if the emulator may handle this instruction. */
+int
+opemu_allow(uint32_t mnemonic)
+{
+	if (!policy_ready)
+		opemu_policy_init();
+
+	int c = opemu_classify(mnemonic);
+	if (c < 0)
+		return 1;
+	if (!opc_emulate[c])
+		return 0;
+
+	uint32_t n = ++opc_hits[c];
+	if (opemu_log && (n == 1 || (n & 0xFFF) == 0))
+		printf("OPEMU: %s %s emulated (%u so far)\n", opc_name[c],
+		    ud_lookup_mnemonic((enum ud_mnemonic_code)mnemonic), n);
+	return 1;
+}
+
+/*
+ * Fast-path hooks (opemu_fast.c): the two hottest instructions, PSHUFB and PALIGNR, skip the generic decoder.
+ * They still obey the policy and are counted/logged like everything else.
+ */
+int
+opemu_ssse3_enabled(void)
+{
+	if (!policy_ready)
+		opemu_policy_init();
+	return opc_emulate[OPC_SSSE3];
+}
+
+void
+opemu_ssse3_hit(int is_palignr)
+{
+	uint32_t n = ++opc_hits[OPC_SSSE3];
+	if (opemu_log && (n == 1 || (n & 0xFFF) == 0))
+		printf("OPEMU: ssse3 %s emulated (%u so far)\n", is_palignr ? "palignr" : "pshufb", n);
+}
diff --git a/src/xnu/osfmk/OPEMU/opemu_util.c b/src/xnu/osfmk/OPEMU/opemu_util.c
new file mode 100644
index 0000000..0fc6416
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/opemu_util.c
@@ -0,0 +1,193 @@
+/*
+ * OPEMU shared helpers: effective addresses, memory access and general purpose registers.
+ *
+ * xcross: the original plugins could only address [base + disp] (no SIB index/scale, RIP-relative used the address of the
+ * faulting instruction instead of the next one, no 32-bit register names). These helpers handle all of that.
+ * Segment overrides (fs:/gs:) are not applied.
+ 
+ *
+ * STATUS
+ *  . Effective addresses with base, SIB index/scale, RIP-relative (relative to the NEXT instruction) and 32-bit addressing; sized user/kernel
+ *  .   memory access; GPR read/write with x86 write semantics for 8/16/32/64-bit names. Segment overrides (fs:/gs:) are not applied.
+ *  . Used by the libudis86 based sets (sse3, ssse3, sse41, sse42); the AVX engine has its own decoder.
+ *
+ * HISTORY
+ *  . XCROSS   New: the original plugins only supported [base + disp] and used the faulting instruction's address for RIP-relative operands
+ */
+#include <stdint.h>
+#include <string.h>
+#include <kern/misc_protos.h>
+#include "opemu.h"
+
+/* register name ranges in libudis86's enum ud_type */
+static int
+reg_in(ud_type_t r, ud_type_t first, ud_type_t last) { return r >= first && r <= last; }
+
+/*
+ * Decode a general purpose register name.
+ * index: x86 encoding number 0..15 (rax,rcx,rdx,rbx,rsp,rbp,rsi,rdi,r8..r15); bits: 8/16/32/64; high8: AH/CH/DH/BH
+ * @return 0 on success, -1 if r is not a general purpose register
+ */
+int
+opemu_gpr_decode(ud_type_t r, int *index, int *bits, int *high8)
+{
+	*high8 = 0;
+	if (reg_in(r, UD_R_AL, UD_R_BL)) { *index = r - UD_R_AL; *bits = 8; return 0; }
+	if (reg_in(r, UD_R_AH, UD_R_BH)) { *index = r - UD_R_AH; *bits = 8; *high8 = 1; return 0; }
+	if (reg_in(r, UD_R_SPL, UD_R_DIL)) { *index = 4 + (r - UD_R_SPL); *bits = 8; return 0; }
+	if (reg_in(r, UD_R_R8B, UD_R_R15B)) { *index = 8 + (r - UD_R_R8B); *bits = 8; return 0; }
+	if (reg_in(r, UD_R_AX, UD_R_DI)) { *index = r - UD_R_AX; *bits = 16; return 0; }
+	if (reg_in(r, UD_R_R8W, UD_R_R15W)) { *index = 8 + (r - UD_R_R8W); *bits = 16; return 0; }
+	if (reg_in(r, UD_R_EAX, UD_R_EDI)) { *index = r - UD_R_EAX; *bits = 32; return 0; }
+	if (reg_in(r, UD_R_R8D, UD_R_R15D)) { *index = 8 + (r - UD_R_R8D); *bits = 32; return 0; }
+	if (reg_in(r, UD_R_RAX, UD_R_RDI)) { *index = r - UD_R_RAX; *bits = 64; return 0; }
+	if (reg_in(r, UD_R_R8, UD_R_R15)) { *index = 8 + (r - UD_R_R8); *bits = 64; return 0; }
+	return -1;
+}
+
+static uint64_t *
+gpr64_slot(x86_saved_state64_t *s, int idx)
+{
+	switch (idx) {
+	case 0: return &s->rax;  case 1: return &s->rcx;  case 2: return &s->rdx;  case 3: return &s->rbx;
+	case 4: return &s->isf.rsp; case 5: return &s->rbp; case 6: return &s->rsi; case 7: return &s->rdi;
+	case 8: return &s->r8;   case 9: return &s->r9;   case 10: return &s->r10; case 11: return &s->r11;
+	case 12: return &s->r12; case 13: return &s->r13; case 14: return &s->r14; case 15: return &s->r15;
+	}
+	return NULL;
+}
+
+static uint32_t *
+gpr32_slot(x86_saved_state32_t *s, int idx)
+{
+	switch (idx) {
+	case 0: return &s->eax; case 1: return &s->ecx; case 2: return &s->edx; case 3: return &s->ebx;
+	case 4: return &s->uesp; case 5: return &s->ebp; case 6: return &s->esi; case 7: return &s->edi;
+	}
+	return NULL;
+}
+
+/* read a register by name (zero extended to 64 bits) */
+int
+opemu_gpr_read(const op_t *op, ud_type_t r, uint64_t *value)
+{
+	int idx, bits, high8;
+	uint64_t v;
+
+	if (opemu_gpr_decode(r, &idx, &bits, &high8) != 0)
+		return -1;
+	if (op->state_flavor == SAVEDSTATE_64) {
+		uint64_t *slot = gpr64_slot(op->state64, idx & ~(high8 ? 4 : 0));
+		if (!slot) return -1;
+		v = *slot;
+	} else {
+		uint32_t *slot = gpr32_slot(op->state32, idx & 7);
+		if (!slot) return -1;
+		v = *slot;
+	}
+	if (high8) v >>= 8;
+	if (bits < 64) v &= (1ULL << bits) - 1;
+	*value = v;
+	return 0;
+}
+
+/* write a register by name with x86 semantics: 32-bit writes zero the upper half, 8/16-bit writes merge */
+int
+opemu_gpr_write(const op_t *op, ud_type_t r, uint64_t value)
+{
+	int idx, bits, high8;
+
+	if (opemu_gpr_decode(r, &idx, &bits, &high8) != 0)
+		return -1;
+	if (op->state_flavor == SAVEDSTATE_64) {
+		uint64_t *slot = gpr64_slot(op->state64, idx);
+		if (!slot) return -1;
+		switch (bits) {
+		case 64: *slot = value; break;
+		case 32: *slot = (uint32_t)value; break;
+		case 16: *slot = (*slot & ~0xffffULL) | (value & 0xffff); break;
+		default:
+			if (high8) *slot = (*slot & ~0xff00ULL) | ((value & 0xff) << 8);
+			else       *slot = (*slot & ~0xffULL) | (value & 0xff);
+		}
+	} else {
+		uint32_t *slot = gpr32_slot(op->state32, idx);
+		if (!slot) return -1;
+		switch (bits) {
+		case 32: *slot = (uint32_t)value; break;
+		case 16: *slot = (*slot & ~0xffffu) | (value & 0xffff); break;
+		default:
+			if (high8) *slot = (*slot & ~0xff00u) | ((value & 0xff) << 8);
+			else       *slot = (*slot & ~0xffu) | (value & 0xff);
+		}
+	}
+	return 0;
+}
+
+/* effective address of a memory operand */
+int
+opemu_ea(const op_t *op, const ud_operand_t *m, uint64_t *addr)
+{
+	uint64_t a = 0, v;
+	int64_t disp = 0;
+
+	if (m->type != UD_OP_MEM)
+		return -1;
+
+	switch (m->offset) {		/* displacement size in bits */
+	case 8:  disp = m->lval.sbyte;  break;
+	case 16: disp = m->lval.sword;  break;
+	case 32: disp = m->lval.sdword; break;
+	case 64: disp = m->lval.sqword; break;
+	}
+
+	if (m->base == UD_R_RIP) {
+		/* RIP-relative: relative to the end of the instruction */
+		if (op->state_flavor == SAVEDSTATE_64)
+			a = op->state64->isf.rip + op->insn_len;
+		else
+			a = op->state32->eip + op->insn_len;
+	} else if (m->base != UD_NONE) {
+		if (opemu_gpr_read(op, m->base, &v) != 0)
+			return -1;
+		a = v;
+	}
+	if (m->index != UD_NONE) {
+		if (opemu_gpr_read(op, m->index, &v) != 0)
+			return -1;
+		a += v * (m->scale ? m->scale : 1);
+	}
+	a += (uint64_t)disp;
+
+	/* 32-bit addressing (0x67 prefix, or a 32-bit process) wraps at 4 GiB */
+	if (op->ud_obj->adr_mode == 32 || op->state_flavor != SAVEDSTATE_64)
+		a &= 0xffffffffULL;
+	*addr = a;
+	return 0;
+}
+
+int
+opemu_load_mem(const op_t *op, const ud_operand_t *m, void *dst, size_t n)
+{
+	uint64_t a;
+	if (opemu_ea(op, m, &a) != 0)
+		return -1;
+	if (op->ring0) {
+		memcpy(dst, (const void *)(uintptr_t)a, n);
+		return 0;
+	}
+	return copyin(a, (char *)dst, n) == 0 ? 0 : -1;
+}
+
+int
+opemu_store_mem(const op_t *op, const ud_operand_t *m, const void *src, size_t n)
+{
+	uint64_t a;
+	if (opemu_ea(op, m, &a) != 0)
+		return -1;
+	if (op->ring0) {
+		memcpy((void *)(uintptr_t)a, src, n);
+		return 0;
+	}
+	return copyout((const char *)src, a, n) == 0 ? 0 : -1;
+}
diff --git a/src/xnu/osfmk/OPEMU/sse3.c b/src/xnu/osfmk/OPEMU/sse3.c
new file mode 100644
index 0000000..cc6ef2e
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/sse3.c
@@ -0,0 +1,398 @@
+/*
+             .d8888b.   .d8888b.  8888888888 .d8888b.
+            d88P  Y88b d88P  Y88b 888       d88P  Y88b
+            Y88b.      Y88b.      888            .d88P
+             "Y888b.    "Y888b.   8888888       8888"
+                "Y88b.     "Y88b. 888            "Y8b.
+                  "888       "888 888       888    888
+            Y88b  d88P Y88b  d88P 888       Y88b  d88P
+             "Y8888P"   "Y8888P"  8888888888 "Y8888P"
+*/
+
+/**
+ * SSE3 emulation (ADDSUB, HADD, HSUB, MOVDDUP, MOVSHDUP, MOVSLDUP, LDDQU, FISTTP ...) for CPUs without SSE3 (AMD K8 rev C and earlier).
+ *
+ * STATUS
+ *  . K10 and later have SSE3 natively, so with opemu=auto these routines are idle on a K10.
+ *  . addsub, hadd and hsub operand order and the clobbering of live XMM registers were fixed; host-tested.
+ *  . x87 FISTTP and MONITOR/MWAIT are untested.
+ *
+ * HISTORY
+ *  . SINETEK  Original SSE3 routines
+ *  . XCROSS   Fixed addsub/hadd/hsub, saved/restored the user's XMM registers
+ */
+
+#include "opemu.h"
+#include "opemu_math.h"
+#include "sse3_priv.h"
+
+/**
+ * Load operands from memory/register, store in obj.
+ * @return: 0 if success
+ */
+int sse3_grab_operands(sse3_t *sse3_obj)
+{
+	if (sse3_obj->islegacy) {
+		_store_mmx (sse3_obj->udo_dst->base - UD_R_MM0, &sse3_obj->dst.uint64[0]);
+		if (sse3_obj->udo_src->type == UD_OP_REG) {
+			_store_mmx (sse3_obj->udo_src->base - UD_R_MM0, &sse3_obj->src.uint64[0]);
+		} else {
+			// m64 load (xcross: shared EA code handles SIB, RIP-relative, 32-bit addressing)
+			if (opemu_load_mem(sse3_obj->op_obj, sse3_obj->udo_src, &sse3_obj->src.uint64[0], 8) != 0) goto bad;
+		}
+	} else {
+		_store_xmm (sse3_obj->udo_dst->base - UD_R_XMM0, &sse3_obj->dst.uint128);
+		if (sse3_obj->udo_src->type == UD_OP_REG) {
+			_store_xmm (sse3_obj->udo_src->base - UD_R_XMM0, &sse3_obj->src.uint128);
+		} else {
+			// m128 load
+			if (opemu_load_mem(sse3_obj->op_obj, sse3_obj->udo_src, &sse3_obj->src.uint128, 16) != 0) goto bad;
+		}
+	}
+
+    return 0;
+
+    // Only reached if bad
+bad:	return -1;
+}
+
+/**
+ * Store operands from obj to memory/register.
+ * @return: 0 if success
+ */
+int sse3_commit_results(const sse3_t *sse3_obj)
+{
+	if (sse3_obj->islegacy) {
+		_load_mmx (sse3_obj->udo_dst->base - UD_R_MM0, (void*) &sse3_obj->res.uint64[0]);
+	} else {
+		_load_xmm (sse3_obj->udo_dst->base - UD_R_XMM0, (void*) &sse3_obj->res.uint128);
+	}
+
+    return 0;
+
+    // Only reached if bad
+//bad:	return -1;
+}
+
+
+/**
+ * Main function for the sse3 portion. Check if the offending
+ * opcode is part of the sse3 instruction set, if not, quit early.
+ * if so, then we build the appropriate context, and jump to the right function.
+ * @param op_obj: opemu object
+ * @return: zero if an instruction was emulated properly
+ */
+int op_sse3_run(const op_t *op_obj)
+{
+	sse3_t sse3_obj;
+	sse3_obj.op_obj = op_obj;
+	const uint32_t mnemonic = ud_insn_mnemonic(sse3_obj.op_obj->ud_obj);
+	sse3_func opf;
+
+	switch (mnemonic) {
+	case UD_Iaddsubpd:	opf = addsubpd;	goto sse3_common;
+	case UD_Iaddsubps:	opf = addsubps;	goto sse3_common;
+    case UD_Ihaddpd:    opf = haddpd; goto sse3_common;
+    case UD_Ihaddps:    opf = haddpd; goto sse3_common;
+    case UD_Ihsubpd:    opf = hsubpd; goto sse3_common;
+    case UD_Ihsubps:    opf = hsubps; goto sse3_common;
+    case UD_Ilddqu:     opf = lddqu; goto sse3_common;
+    case UD_Imovddup:   opf = movddup; goto sse3_common;
+    case UD_Imovshdup:  opf = movshdup; goto sse3_common;
+    case UD_Imovsldup:  opf = movsldup; goto sse3_common;
+    case UD_Ifistp:     opf = fisttp; opf(&sse3_obj); goto good;
+    case UD_Imwait:     goto good;
+    case UD_Imonitor:   goto good;
+sse3_common:
+	
+	sse3_obj.udo_src = ud_insn_opr (op_obj->ud_obj, 1);
+	sse3_obj.udo_dst = ud_insn_opr (op_obj->ud_obj, 0);
+	sse3_obj.udo_imm = ud_insn_opr (op_obj->ud_obj, 2);
+
+	// run some sanity checks,
+	if (sse3_obj.udo_dst->type != UD_OP_REG) goto bad;
+	if ((sse3_obj.udo_src->type != UD_OP_REG)
+		&& (sse3_obj.udo_src->type != UD_OP_MEM))
+		goto bad;
+
+	// i'd like to know if this instruction is legacy mmx
+	if ((sse3_obj.udo_dst->base >= UD_R_MM0)
+		&& (sse3_obj.udo_dst->base <= UD_R_MM7)) {
+		sse3_obj.islegacy = 1;
+	} else sse3_obj.islegacy = 0;
+	
+	if (sse3_grab_operands(&sse3_obj) != 0) goto bad;
+
+	/* xcross: the FP routines use XMM registers while the user's are still live: save and restore them */
+	{
+		uint8_t xs[256] __attribute__((aligned(16)));
+		opemu_xmm_save(xs);
+		opf(&sse3_obj);
+		opemu_xmm_restore(xs);
+	}
+
+	if (sse3_commit_results(&sse3_obj)) goto bad;
+
+	goto good;
+
+	default: goto bad;
+	}
+
+good:
+	return 0;
+
+    // Only reached if bad
+bad:
+	return -1;
+}
+
+void fisttp(sse3_t *this)
+{
+    const unsigned char *bytep = (const unsigned char *)ud_insn_hex((ud_t *)&this->op_obj->ud_obj);
+    uint8_t islongmode = is_saved_state64(this->op_obj->state);
+    int ins_size = 0;
+    uint8_t base = 0;
+    uint8_t mod = 0;
+    int8_t add = 0;
+    uint8_t modrm = 0;
+    uint64_t address = 0;
+    uint64_t reg_sel[8];
+    
+    if (islongmode)
+    {
+        reg_sel[0] = this->op_obj->state64->rax;
+        reg_sel[1] = this->op_obj->state64->rcx;
+        reg_sel[2] = this->op_obj->state64->rdx;
+        reg_sel[3] = this->op_obj->state64->rbx;
+        reg_sel[4] = this->op_obj->state64->isf.rsp;
+        reg_sel[5] = this->op_obj->state64->rbp;
+        reg_sel[6] = this->op_obj->state64->rsi;
+        reg_sel[7] = this->op_obj->state64->rdi;
+    } else {
+        reg_sel[0] = this->op_obj->state32->eax;
+        reg_sel[1] = this->op_obj->state32->ecx;
+        reg_sel[2] = this->op_obj->state32->edx;
+        reg_sel[3] = this->op_obj->state32->ebx;
+        reg_sel[4] = this->op_obj->state32->uesp;
+        reg_sel[5] = this->op_obj->state32->ebp;
+        reg_sel[6] = this->op_obj->state32->esi;
+        reg_sel[7] = this->op_obj->state32->edi;
+    }
+    
+    if (*bytep == 0x66)
+    {
+        bytep++;
+        ins_size++;
+    }
+    
+    switch (*bytep)
+    {
+        case 0xDB:
+            bytep++;
+            ins_size++;
+            
+            modrm = *bytep;
+            base = modrm & 0x7;
+            mod = (modrm & 0xC0) >> 6;
+            
+            if (mod == 0)
+            {
+                address = reg_sel[base];
+            } else if (mod == 1) {
+                bytep++;
+                ins_size++;
+                
+                add = *bytep;
+                address = reg_sel[base] + add;
+            } else {
+                return;
+            }
+            
+            fisttpl((double *)address);
+            
+            ins_size++;
+            
+            return;
+            break;
+            
+        case 0xDD:
+            bytep++;
+            ins_size++;
+            
+            modrm = *bytep;
+            base = modrm & 0x7;
+            mod = (modrm & 0xC0) >> 6;
+            
+            if (mod == 0)
+            {
+                address = reg_sel[base];
+            } else if (mod == 1) {
+                bytep++;
+                ins_size++;
+                
+                add = *bytep;
+                address = reg_sel[base] + add;
+            } else {
+                return;
+            }
+            
+            fisttpq((long double *)address);
+            
+            ins_size++;
+            
+            return;
+            break;
+            
+        case 0xDF:
+            bytep++;
+            ins_size++;
+            
+            modrm = *bytep;
+            base = modrm & 0x7;
+            mod = (modrm & 0xC0) >> 6;
+            
+            if (mod == 0)
+            {
+                address = reg_sel[base];
+            } else if (mod == 1) {
+                bytep++;
+                ins_size++;
+                
+                add = *bytep;
+                address = reg_sel[base] + add;
+            } else {
+                return;
+            }
+            
+            fisttps((float *)address);
+            
+            ins_size++;
+            
+            return;
+            break;
+    }
+}
+
+/*********************************************/
+/** AnV - SSE3 instructions implementation  **/
+/*********************************************/
+
+void fisttps(float *res)
+{
+    float value = opemu_truncf(*res);
+    __asm__ ("fistps %0" : : "m" (value));
+    *res = value;
+}
+
+void fisttpl(double *res)
+{
+    double value = opemu_trunc(*res);
+    __asm__ ("fistpl %0" : : "m" (value));
+    *res = value;
+}
+
+void fisttpq(long double *res)
+{
+    // AnV - Truncl doesn't work but fistpq has same result in this case... (tested)
+    long double value = *res; /*opemu_truncl(*res);*/
+    __asm__ ("fistpq %0" : : "m" (value));
+    *res = value;
+}
+
+/* xcross: operand order fixed against the hardware (dst = first operand = xmm1, src = second operand).
+ * addsub: dst[even] - src[even], dst[odd] + src[odd].  hadd/hsub: the dst pair(s) first, then the src pair(s). */
+void addsubpd(sse3_t *this)
+{
+    const double *src = &this->src.fa64[0];
+    const double *dst = &this->dst.fa64[0];
+    double *res = &this->res.fa64[0];
+    res[0] = dst[0] - src[0];
+    res[1] = dst[1] + src[1];
+}
+
+void addsubps(sse3_t *this)
+{
+    const float *src = &this->src.fa32[0];
+    const float *dst = &this->dst.fa32[0];
+    float *res = &this->res.fa32[0];
+    res[0] = dst[0] - src[0];
+    res[1] = dst[1] + src[1];
+    res[2] = dst[2] - src[2];
+    res[3] = dst[3] + src[3];
+}
+
+void haddpd(sse3_t *this)
+{
+    const double *src = &this->src.fa64[0];
+    const double *dst = &this->dst.fa64[0];
+    double *res = &this->res.fa64[0];
+    res[0] = dst[0] + dst[1];
+    res[1] = src[0] + src[1];
+}
+
+void haddps(sse3_t *this)
+{
+    const float *src = &this->src.fa32[0];
+    const float *dst = &this->dst.fa32[0];
+    float *res = &this->res.fa32[0];
+    res[0] = dst[0] + dst[1];
+    res[1] = dst[2] + dst[3];
+    res[2] = src[0] + src[1];
+    res[3] = src[2] + src[3];
+}
+
+void hsubpd(sse3_t *this)
+{
+    const double *src = &this->src.fa64[0];
+    const double *dst = &this->dst.fa64[0];
+    double *res = &this->res.fa64[0];
+    res[0] = dst[0] - dst[1];
+    res[1] = src[0] - src[1];
+}
+
+void hsubps(sse3_t *this)
+{
+    const float *src = &this->src.fa32[0];
+    const float *dst = &this->dst.fa32[0];
+    float *res = &this->res.fa32[0];
+    res[0] = dst[0] - dst[1];
+    res[1] = dst[2] - dst[3];
+    res[2] = src[0] - src[1];
+    res[3] = src[2] - src[3];
+}
+
+void lddqu(sse3_t *this)
+{
+    const double *src = &this->src.fa64[0];
+    double *res = &this->res.fa64[0];
+    res[0] = src[0];
+    res[1] = src[1];
+}
+
+void movddup(sse3_t *this)
+{
+    const double *src = &this->src.fa64[0];
+    double *res = &this->res.fa64[0];
+    res[0] = src[0];
+    res[1] = src[0];
+}
+
+void movshdup(sse3_t *this)
+{
+    const float *src = &this->src.fa32[0];
+    float *res = &this->res.fa32[0];
+    res[0] = src[1];
+    res[1] = src[1];
+    res[2] = src[3];
+    res[3] = src[3];
+}
+
+void movsldup(sse3_t *this)
+{
+    const float *src = &this->src.fa32[0];
+    float *res = &this->res.fa32[0];
+    res[0] = src[0];
+    res[1] = src[0];
+    res[2] = src[2];
+    res[3] = src[2];
+}
diff --git a/src/xnu/osfmk/OPEMU/sse3_priv.h b/src/xnu/osfmk/OPEMU/sse3_priv.h
new file mode 100644
index 0000000..cdce984
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/sse3_priv.h
@@ -0,0 +1,182 @@
+#pragma once
+
+#include "opemu.h"
+#include "libudis86/extern.h"
+
+// log function debug
+#define LF	D("%s\n", __PRETTY_FUNCTION__);
+#define D	printf
+
+/**
+ * 128-bit Register proper for sse3
+ * For 64-bit operations, use the same register type, and ignore the high values
+ */
+union __attribute__((__packed__)) sse_reg {
+	int8_t		int8[16];
+	int16_t		int16[8];
+	int32_t		int32[4];
+	int64_t		int64[2];
+	__int128_t	int128;
+    float       fa32[4];
+	uint8_t		uint8[16];
+	uint16_t	uint16[8];
+	uint32_t	uint32[4];
+	uint64_t	uint64[2];
+    double      fa64[2];
+	__uint128_t	uint128;
+};
+typedef union sse_reg sse_reg_t;
+
+/**
+ * Print said register to screen. Useful for debugging
+ * @param  uint128
+ */
+#define print128(x)	printf("0x%016llx%016llx", ((uint64_t*)(&(x)))[1], ((uint64_t*)(&(x)))[0] );
+
+/**
+ * sse3 object
+ */
+struct sse3 {
+	uint8_t	extended;	// bool type
+
+	sse_reg_t		dst, src;
+	sse_reg_t		res;
+
+	// operands
+	const ud_operand_t	*udo_src, *udo_dst, *udo_imm;
+
+	// objects
+	const op_t		*op_obj;
+
+	// legacy mmx flag
+	uint8_t 		islegacy;
+};
+typedef struct sse3 sse3_t;
+
+
+
+/**
+ * Instruction emulation function type.
+ */
+typedef void (*sse3_func)(sse3_t*);
+
+
+#define storedqu_template(n, where)					\
+	do {								\
+	asm __volatile__ ("movdqu %%xmm" #n ", %0" : "=m" (*(where)));	\
+	} while (0);
+
+#define loaddqu_template(n, where)					\
+	do {								\
+	asm __volatile__ ("movdqu %0, %%xmm" #n :: "m" (*(where)));	\
+	} while (0);
+
+#define storeq_template(n, where)					\
+	do {								\
+	asm __volatile__ ("movq %%mm" #n ", %0" : "=m" (*(where)));	\
+	} while (0);
+
+#define loadq_template(n, where)					\
+	do {								\
+	asm __volatile__ ("movq %0, %%mm" #n :: "m" (*(where)));	\
+	} while (0);
+
+/**
+ * Store xmm register somewhere in memory
+ */
+inline void _store_xmm (const uint8_t n, __uint128_t *where)
+{
+	switch (n) {
+case 0:  storedqu_template(0, where); break;
+case 1:  storedqu_template(1, where); break;
+case 2:  storedqu_template(2, where); break;
+case 3:  storedqu_template(3, where); break;
+case 4:  storedqu_template(4, where); break;
+case 5:  storedqu_template(5, where); break;
+case 6:  storedqu_template(6, where); break;
+case 7:  storedqu_template(7, where); break;
+case 8:  storedqu_template(8, where); break;
+case 9:  storedqu_template(9, where); break;
+case 10: storedqu_template(10, where); break;
+case 11: storedqu_template(11, where); break;
+case 12: storedqu_template(12, where); break;
+case 13: storedqu_template(13, where); break;
+case 14: storedqu_template(14, where); break;
+case 15: storedqu_template(15, where); break;
+}}
+
+/**
+ * Load xmm register from memory
+ */
+inline void _load_xmm (const uint8_t n, const __uint128_t *where)
+{
+	switch (n) {
+case 0:  loaddqu_template(0, where); break;
+case 1:  loaddqu_template(1, where); break;
+case 2:  loaddqu_template(2, where); break;
+case 3:  loaddqu_template(3, where); break;
+case 4:  loaddqu_template(4, where); break;
+case 5:  loaddqu_template(5, where); break;
+case 6:  loaddqu_template(6, where); break;
+case 7:  loaddqu_template(7, where); break;
+case 8:  loaddqu_template(8, where); break;
+case 9:  loaddqu_template(9, where); break;
+case 10: loaddqu_template(10, where); break;
+case 11: loaddqu_template(11, where); break;
+case 12: loaddqu_template(12, where); break;
+case 13: loaddqu_template(13, where); break;
+case 14: loaddqu_template(14, where); break;
+case 15: loaddqu_template(15, where); break;
+}}
+
+/**
+ * Store mmx register somewhere in memory
+ */
+inline void _store_mmx (const uint8_t n, uint64_t *where)
+{
+	switch (n) {
+case 0:  storeq_template(0, where); break;
+case 1:  storeq_template(1, where); break;
+case 2:  storeq_template(2, where); break;
+case 3:  storeq_template(3, where); break;
+case 4:  storeq_template(4, where); break;
+case 5:  storeq_template(5, where); break;
+case 6:  storeq_template(6, where); break;
+case 7:  storeq_template(7, where); break;
+}}
+
+/**
+ * Load mmx register from memory
+ */
+inline void _load_mmx (const uint8_t n, const uint64_t *where)
+{
+	switch (n) {
+case 0:  loadq_template(0, where); break;
+case 1:  loadq_template(1, where); break;
+case 2:  loadq_template(2, where); break;
+case 3:  loadq_template(3, where); break;
+case 4:  loadq_template(4, where); break;
+case 5:  loadq_template(5, where); break;
+case 6:  loadq_template(6, where); break;
+case 7:  loadq_template(7, where); break;
+}}
+
+inline int sse3_grab_operands(sse3_t*);
+inline int sse3_commit_results(const sse3_t*);
+inline int op_sse3_run(const op_t*);
+
+/** AnV - SSE3 instructions **/
+inline void addsubpd   (sse3_t*);
+inline void addsubps   (sse3_t*);
+inline void haddpd     (sse3_t*);
+inline void haddps     (sse3_t*);
+inline void hsubpd     (sse3_t*);
+inline void hsubps     (sse3_t*);
+inline void lddqu      (sse3_t*);
+inline void movddup    (sse3_t*);
+inline void movshdup   (sse3_t*);
+inline void movsldup   (sse3_t*);
+inline void fisttp     (sse3_t*);
+inline void fisttps    (float *res);
+inline void fisttpl    (double *res);
+inline void fisttpq    (long double *res);
diff --git a/src/xnu/osfmk/OPEMU/sse41.c b/src/xnu/osfmk/OPEMU/sse41.c
new file mode 100644
index 0000000..172137d
--- /dev/null
+++ b/src/xnu/osfmk/OPEMU/sse41.c
@@ -0,0 +1,363 @@
+/*
+ * SSE4.1 (+ POPCNT, CRC32) emulation for CPUs that lack them (AMD K8/K10).
+ *
+ * xcross: new. Written from Intel's SDM and verified bit-for-bit against the hardware instructions by
+ * scripts/opemu-hosttest.sh. Each instruction is a small routine on an ssse3_t (dst = first operand, src = second operand);
+ * op_sse41_run() does the operand decoding (registers, memory with the correct size, GPRs) and the write-back.
+ *
+ * Not implemented: AVX and later (userland only uses them when the capability bits say so, which they do not on K8/K10),
+ * segment-override addressing (fs:/gs:), and the MMX-register forms (SSE4.1 has none).
+ 
+ *
+ * STATUS
+ *  . All SSE4.1 instructions plus POPCNT and CRC32 (CRC32C); host-tested bit for bit (see sse42.c for the run that covers it).
+ *
+ * HISTORY
+ *  . XCROSS   New: SSE4.1 did not exist in the original emulator; written from the Intel SDM
+ */
+#include <stdint.h>
+#include <string.h>
+#include "ssse3_priv.h"
+
+#define RF_CF	0x0001
+#define RF_PF	0x0004
+#define RF_AF	0x0010
+#define RF_ZF	0x0040
+#define RF_SF	0x0080
+#define RF_OF	0x0800
+#define RF_ARITH (RF_CF | RF_PF | RF_AF | RF_ZF | RF_SF | RF_OF)
+
+/* ------------------------------------------------------------------ blends */
+void s41_pblendw(ssse3_t *t) { uint8_t m = t->udo_imm->lval.ubyte; for (int i = 0; i < 8; i++) t->res.uint16[i] = (m >> i & 1) ? t->src.uint16[i] : t->dst.uint16[i]; }
+void s41_blendps(ssse3_t *t) { uint8_t m = t->udo_imm->lval.ubyte; for (int i = 0; i < 4; i++) t->res.uint32[i] = (m >> i & 1) ? t->src.uint32[i] : t->dst.uint32[i]; }
+void s41_blendpd(ssse3_t *t) { uint8_t m = t->udo_imm->lval.ubyte; for (int i = 0; i < 2; i++) t->res.uint64[i] = (m >> i & 1) ? t->src.uint64[i] : t->dst.uint64[i]; }
+void s41_pblendvb(ssse3_t *t) { for (int i = 0; i < 16; i++) t->res.uint8[i] = (t->xmm0.uint8[i] & 0x80) ? t->src.uint8[i] : t->dst.uint8[i]; }
+void s41_blendvps(ssse3_t *t) { for (int i = 0; i < 4; i++) t->res.uint32[i] = (t->xmm0.uint32[i] >> 31) ? t->src.uint32[i] : t->dst.uint32[i]; }
+void s41_blendvpd(ssse3_t *t) { for (int i = 0; i < 2; i++) t->res.uint64[i] = (t->xmm0.uint64[i] >> 63) ? t->src.uint64[i] : t->dst.uint64[i]; }
+
+/* ------------------------------------------------------------ dot products */
+void s41_dpps(ssse3_t *t)
+{
+	uint8_t m = t->udo_imm->lval.ubyte;
+	float tmp[4], sum, d[4], s[4], r[4];
+	memcpy(d, &t->dst, 16); memcpy(s, &t->src, 16);
+	for (int i = 0; i < 4; i++) tmp[i] = (m & (0x10 << i)) ? d[i] * s[i] : 0.0f;
+	sum = (tmp[0] + tmp[1]) + (tmp[2] + tmp[3]);
+	for (int i = 0; i < 4; i++) r[i] = (m & (1 << i)) ? sum : 0.0f;
+	memcpy(&t->res, r, 16);
+}
+void s41_dppd(ssse3_t *t)
+{
+	uint8_t m = t->udo_imm->lval.ubyte;
+	double tmp[2], sum, d[2], s[2], r[2];
+	memcpy(d, &t->dst, 16); memcpy(s, &t->src, 16);
+	for (int i = 0; i < 2; i++) tmp[i] = (m & (0x10 << i)) ? d[i] * s[i] : 0.0;
+	sum = tmp[0] + tmp[1];
+	for (int i = 0; i < 2; i++) r[i] = (m & (1 << i)) ? sum : 0.0;
+	memcpy(&t->res, r, 16);
+}
+
+/* ----------------------------------------------------------- insert/extract */
+void s41_insertps(ssse3_t *t)
+{
+	uint8_t m = t->udo_imm->lval.ubyte;
+	int cs = t->extended ? 0 : (m >> 6) & 3;	/* extended: source is a 32-bit memory operand */
+	int cd = (m >> 4) & 3;
+	t->res = t->dst;
+	t->res.uint32[cd] = t->src.uint32[cs];
+	for (int i = 0; i < 4; i++) if (m >> i & 1) t->res.uint32[i] = 0;
+}
+void s41_pinsrb(ssse3_t *t) { t->res = t->dst; t->res.uint8[t->udo_imm->lval.ubyte & 15] = (uint8_t)t->gpr_in; }
+void s41_pinsrd(ssse3_t *t) { t->res = t->dst; t->res.uint32[t->udo_imm->lval.ubyte & 3] = (uint32_t)t->gpr_in; }
+void s41_pinsrq(ssse3_t *t) { t->res = t->dst; t->res.uint64[t->udo_imm->lval.ubyte & 1] = t->gpr_in; }
+/* the xmm operand of the extract forms is passed in src */
+void s41_pextrb(ssse3_t *t) { t->gpr_out = t->src.uint8[t->udo_imm->lval.ubyte & 15]; }
+void s41_pextrd(ssse3_t *t) { t->gpr_out = t->src.uint32[t->udo_imm->lval.ubyte & 3]; }
+void s41_pextrq(ssse3_t *t) { t->gpr_out = t->src.uint64[t->udo_imm->lval.ubyte & 1]; }
+
+/* ----------------------------------------------------------- integer misc */
+void s41_mpsadbw(ssse3_t *t)
+{
+	uint8_t m = t->udo_imm->lval.ubyte;
+	int so = (m & 3) * 4, dof = ((m >> 2) & 1) * 4;
+	for (int i = 0; i < 8; i++) {
+		int sum = 0;
+		for (int j = 0; j < 4; j++) {
+			int a = t->dst.uint8[dof + i + j], b = t->src.uint8[so + j];
+			sum += a > b ? a - b : b - a;
+		}
+		t->res.uint16[i] = (uint16_t)sum;
+	}
+}
+void s41_packusdw(ssse3_t *t)
+{
+	for (int i = 0; i < 4; i++) {
+		int32_t a = t->dst.int32[i], b = t->src.int32[i];
+		t->res.uint16[i]     = a < 0 ? 0 : a > 65535 ? 65535 : (uint16_t)a;
+		t->res.uint16[i + 4] = b < 0 ? 0 : b > 65535 ? 65535 : (uint16_t)b;
+	}
+}
+void s41_pcmpeqq(ssse3_t *t) { for (int i = 0; i < 2; i++) t->res.uint64[i] = t->dst.uint64[i] == t->src.uint64[i] ? ~0ULL : 0; }
+void s41_phminposuw(ssse3_t *t)
+{
+	uint16_t min = t->src.uint16[0]; int idx = 0;
+	for (int i = 1; i < 8; i++) if (t->src.uint16[i] < min) { min = t->src.uint16[i]; idx = i; }
+	t->res.uint128 = 0; t->res.uint16[0] = min; t->res.uint16[1] = (uint16_t)idx;
+}
+#define MINMAX(name, T, f, op) void name(ssse3_t *t) { for (int i = 0; i < (int)(16 / sizeof(T)); i++) \
+	t->res.f[i] = (t->dst.f[i] op t->src.f[i]) ? t->dst.f[i] : t->src.f[i]; }
+MINMAX(s41_pmaxsb, int8_t,   int8,   >)
+MINMAX(s41_pmaxsd, int32_t,  int32,  >)
+MINMAX(s41_pmaxuw, uint16_t, uint16, >)
+MINMAX(s41_pmaxud, uint32_t, uint32, >)
+MINMAX(s41_pminsb, int8_t,   int8,   <)
+MINMAX(s41_pminsd, int32_t,  int32,  <)
+MINMAX(s41_pminuw, uint16_t, uint16, <)
+MINMAX(s41_pminud, uint32_t, uint32, <)
+
+void s41_pmuldq(ssse3_t *t) { t->res.int64[0] = (int64_t)t->dst.int32[0] * t->src.int32[0]; t->res.int64[1] = (int64_t)t->dst.int32[2] * t->src.int32[2]; }
+void s41_pmulld(ssse3_t *t) { for (int i = 0; i < 4; i++) t->res.uint32[i] = t->dst.uint32[i] * t->src.uint32[i]; }
+void s41_movntdqa(ssse3_t *t) { t->res = t->src; }
+
+/* sign/zero extension: element counts and sizes from the mnemonic */
+#define PMOV(name, STYPE, SF, DF, N, EXT) void name(ssse3_t *t) { for (int i = 0; i < N; i++) t->res.DF[i] = (EXT)(STYPE)t->src.SF[i]; }
+PMOV(s41_pmovsxbw, int8_t,   int8,   int16, 8, int16_t)
+PMOV(s41_pmovsxbd, int8_t,   int8,   int32, 4, int32_t)
+PMOV(s41_pmovsxbq, int8_t,   int8,   int64, 2, int64_t)
+PMOV(s41_pmovsxwd, int16_t,  int16,  int32, 4, int32_t)
+PMOV(s41_pmovsxwq, int16_t,  int16,  int64, 2, int64_t)
+PMOV(s41_pmovsxdq, int32_t,  int32,  int64, 2, int64_t)
+PMOV(s41_pmovzxbw, uint8_t,  uint8,  uint16, 8, uint16_t)
+PMOV(s41_pmovzxbd, uint8_t,  uint8,  uint32, 4, uint32_t)
+PMOV(s41_pmovzxbq, uint8_t,  uint8,  uint64, 2, uint64_t)
+PMOV(s41_pmovzxwd, uint16_t, uint16, uint32, 4, uint32_t)
+PMOV(s41_pmovzxwq, uint16_t, uint16, uint64, 2, uint64_t)
+PMOV(s41_pmovzxdq, uint32_t, uint32, uint64, 2, uint64_t)
+
+void s41_ptest(ssse3_t *t)
+{
+	int zf = !((t->dst.uint64[0] & t->src.uint64[0]) | (t->dst.uint64[1] & t->src.uint64[1]));
+	int cf = !((~t->dst.uint64[0] & t->src.uint64[0]) | (~t->dst.uint64[1] & t->src.uint64[1]));
+	t->flags_out = (zf ? RF_ZF : 0) | (cf ? RF_CF : 0);
+}
+
+/* -------------------------------------------------------------- scalar ops */
+void s41_popcnt(ssse3_t *t)
+{
+	uint64_t v = t->gpr_in; int n = 0;
+	if (t->opsize < 64) v &= (1ULL << t->opsize) - 1;
+	t->flags_out = v ? 0 : RF_ZF;
+	while (v) { v &= v - 1; n++; }
+	t->gpr_out = (uint64_t)n;
+}
+/* CRC32C (Castagnoli, reflected 0x82F63B78). gpr_out holds the accumulator on entry and the result on exit. */
+void s41_crc32(ssse3_t *t)
+{
+	uint32_t crc = (uint32_t)t->gpr_out;
+	int bytes = t->opsize / 8;
+	for (int b = 0; b < bytes; b++) {
+		crc ^= (uint8_t)(t->gpr_in >> (8 * b));
+		for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0x82F63B78u & (uint32_t)-(int32_t)(crc & 1));
+	}
+	t->gpr_out = crc;
+}
+
+/* ---------------------------------------------------------------- rounding */
+static uint64_t d2u(double x) { uint64_t u; memcpy(&u, &x, 8); return u; }
+static double   u2d(uint64_t u) { double x; memcpy(&x, &u, 8); return x; }
+
+/* mode: 0 nearest-even, 1 down, 2 up, 3 truncate */
+static double
+rnd_double(double x, int mode)
+{
+	uint64_t u = d2u(x), sign = u & 0x8000000000000000ULL;
+	int e = (int)((u >> 52) & 0x7ff);
+	double ax, t, frac, r;
+
+	if (e == 0x7ff)	/* inf stays, NaN is quieted */
+		return (u & 0xfffffffffffffULL) ? u2d(u | 0x8000000000000ULL) : x;
+	if (e >= 1075)	/* |x| >= 2^52: already integral */
+		return x;
+	ax = u2d(u & 0x7fffffffffffffffULL);
+	t = (double)(int64_t)ax;
+	frac = ax - t;
+	switch (mode) {
+	case 3:  r = t; break;
+	case 1:  r = (sign && frac > 0) ? t + 1 : t; break;
+	case 2:  r = (!sign && frac > 0) ? t + 1 : t; break;
+	default: r = (frac > 0.5 || (frac == 0.5 && ((int64_t)t & 1))) ? t + 1 : t; break;
+	}
+	return u2d(d2u(r) | sign);
+}
+
+static float
+rnd_float(float x, int mode)
+{
+	uint32_t u; memcpy(&u, &x, 4);
+	int e = (int)((u >> 23) & 0xff);
+	if (e == 0xff) {
+		if (u & 0x7fffff) { u |= 0x400000; memcpy(&x, &u, 4); }	/* quiet NaN */
+		return x;
+	}
+	if (e >= 150) return x;					/* |x| >= 2^23: already integral */
+	return (float)rnd_double((double)x, mode);
+}
+
+static int
+round_mode(uint8_t imm)
+{
+	if (imm & 4) {	/* use MXCSR.RC */
+		uint32_t m;
+		__asm__ __volatile__("stmxcsr %0" : "=m"(m));
+		return (m >> 13) & 3;
+	}
+	return imm & 3;
+}
+
+void s41_roundps(ssse3_t *t) { int m = round_mode(t->udo_imm->lval.ubyte); float s[4], r[4]; memcpy(s, &t->src, 16); for (int i = 0; i < 4; i++) r[i] = rnd_float(s[i], m); memcpy(&t->res, r, 16); }
+void s41_roundpd(ssse3_t *t) { int m = round_mode(t->udo_imm->lval.ubyte); double s[2], r[2]; memcpy(s, &t->src, 16); for (int i = 0; i < 2; i++) r[i] = rnd_double(s[i], m); memcpy(&t->res, r, 16); }
+void s41_roundss(ssse3_t *t) { int m = round_mode(t->udo_imm->lval.ubyte); float s[4], r; memcpy(s, &t->src, 16); r = rnd_float(s[0], m); t->res = t->dst; memcpy(&t->res, &r, 4); }
+void s41_roundsd(ssse3_t *t) { int m = round_mode(t->udo_imm->lval.ubyte); double s[2], r; memcpy(s, &t->src, 16); r = rnd_double(s[0], m); t->res = t->dst; memcpy(&t->res, &r, 8); }
+
+/* ---------------------------------------------------------------- dispatcher */
+enum kind { K_XMM, K_BLENDV, K_PINSR, K_PEXTR, K_PTEST, K_POPCNT, K_CRC32 };
+
+static const struct ent {
+	uint32_t mnemonic; uint8_t kind; uint8_t memsz; uint8_t fp; ssse3_func f;
+} tab[] = {
+#define E(m, kind, memsz, fp, f) { UD_I##m, kind, memsz, fp, f }
+	E(pblendw, K_XMM, 16, 0, s41_pblendw), E(blendps, K_XMM, 16, 0, s41_blendps), E(blendpd, K_XMM, 16, 0, s41_blendpd),
+	E(pblendvb, K_BLENDV, 16, 0, s41_pblendvb), E(blendvps, K_BLENDV, 16, 0, s41_blendvps), E(blendvpd, K_BLENDV, 16, 0, s41_blendvpd),
+	E(dpps, K_XMM, 16, 1, s41_dpps), E(dppd, K_XMM, 16, 1, s41_dppd), E(insertps, K_XMM, 4, 0, s41_insertps),
+	E(movntdqa, K_XMM, 16, 0, s41_movntdqa), E(mpsadbw, K_XMM, 16, 0, s41_mpsadbw), E(packusdw, K_XMM, 16, 0, s41_packusdw),
+	E(pcmpeqq, K_XMM, 16, 0, s41_pcmpeqq), E(phminposuw, K_XMM, 16, 0, s41_phminposuw),
+	E(pmaxsb, K_XMM, 16, 0, s41_pmaxsb), E(pmaxsd, K_XMM, 16, 0, s41_pmaxsd), E(pmaxuw, K_XMM, 16, 0, s41_pmaxuw), E(pmaxud, K_XMM, 16, 0, s41_pmaxud),
+	E(pminsb, K_XMM, 16, 0, s41_pminsb), E(pminsd, K_XMM, 16, 0, s41_pminsd), E(pminuw, K_XMM, 16, 0, s41_pminuw), E(pminud, K_XMM, 16, 0, s41_pminud),
+	E(pmuldq, K_XMM, 16, 0, s41_pmuldq), E(pmulld, K_XMM, 16, 0, s41_pmulld),
+	E(pmovsxbw, K_XMM, 8, 0, s41_pmovsxbw), E(pmovsxbd, K_XMM, 4, 0, s41_pmovsxbd), E(pmovsxbq, K_XMM, 2, 0, s41_pmovsxbq),
+	E(pmovsxwd, K_XMM, 8, 0, s41_pmovsxwd), E(pmovsxwq, K_XMM, 4, 0, s41_pmovsxwq), E(pmovsxdq, K_XMM, 8, 0, s41_pmovsxdq),
+	E(pmovzxbw, K_XMM, 8, 0, s41_pmovzxbw), E(pmovzxbd, K_XMM, 4, 0, s41_pmovzxbd), E(pmovzxbq, K_XMM, 2, 0, s41_pmovzxbq),
+	E(pmovzxwd, K_XMM, 8, 0, s41_pmovzxwd), E(pmovzxwq, K_XMM, 4, 0, s41_pmovzxwq), E(pmovzxdq, K_XMM, 8, 0, s41_pmovzxdq),
+	E(roundps, K_XMM, 16, 1, s41_roundps), E(roundpd, K_XMM, 16, 1, s41_roundpd), E(roundss, K_XMM, 4, 1, s41_roundss), E(roundsd, K_XMM, 8, 1, s41_roundsd),
+	E(ptest, K_PTEST, 16, 0, s41_ptest),
+	E(pinsrb, K_PINSR, 1, 0, s41_pinsrb), E(pinsrd, K_PINSR, 4, 0, s41_pinsrd), E(pinsrq, K_PINSR, 8, 0, s41_pinsrq),
+	E(pextrb, K_PEXTR, 1, 0, s41_pextrb), E(pextrd, K_PEXTR, 4, 0, s41_pextrd), E(pextrq, K_PEXTR, 8, 0, s41_pextrq),
+	E(extractps, K_PEXTR, 4, 0, s41_pextrd),
+	E(popcnt, K_POPCNT, 0, 0, s41_popcnt), E(crc32, K_CRC32, 0, 0, s41_crc32),
+};
+
+static int
+is_xmm(const ud_operand_t *o) { return o && o->type == UD_OP_REG && o->base >= UD_R_XMM0 && o->base <= UD_R_XMM15; }
+
+static void
+apply_flags(const op_t *op, uint32_t f)
+{
+	if (op->state_flavor == SAVEDSTATE_64)
+		op->state64->isf.rflags = (op->state64->isf.rflags & ~(uint64_t)RF_ARITH) | f;
+	else
+		op->state32->efl = (op->state32->efl & ~(uint32_t)RF_ARITH) | f;
+}
+
+/*
+ * xcross: the user's XMM registers are live in the CPU while we run, and any code we execute (memset, float arithmetic,
+ * ...) may clobber them. So op_sse41_run() snapshots all sixteen first, the instruction is emulated against the snapshot,
+ * and the snapshot (with the destination updated) is restored at the end.
+ */
+static int sse41_run(const op_t *op, uint8_t *xs);
+
+int
+op_sse41_run(const op_t *op)
+{
+	uint8_t xs[256] __attribute__((aligned(16)));
+	int r;
+	opemu_xmm_save(xs);
+	r = sse41_run(op, xs);
+	opemu_xmm_restore(xs);
+	return r;
+}
+
+#define XREG(n)	((void *)(xs + 16 * (n)))
+
+static int
+sse41_run(const op_t *op, uint8_t *xs)
+{
+	const ud_t *ud = op->ud_obj;
+	const uint32_t mn = ud_insn_mnemonic((ud_t *)ud);
+	const struct ent *e = NULL;
+	ssse3_t t;
+	ud_operand_t noimm;
+	const ud_operand_t *o0, *o1, *o2;
+
+	for (unsigned i = 0; i < sizeof tab / sizeof *tab; i++)
+		if (tab[i].mnemonic == mn) { e = &tab[i]; break; }
+	if (!e)
+		return -1;
+
+	memset(&t, 0, sizeof t);
+	memset(&noimm, 0, sizeof noimm);
+	noimm.type = UD_OP_IMM;
+	o0 = ud_insn_opr((ud_t *)ud, 0); o1 = ud_insn_opr((ud_t *)ud, 1); o2 = ud_insn_opr((ud_t *)ud, 2);
+	if (!o0 || !o1) return -1;
+	t.op_obj = op; t.udo_dst = o0; t.udo_src = o1;
+	t.udo_imm = (o2 && o2->type == UD_OP_IMM) ? o2 : &noimm;
+
+	switch (e->kind) {
+	case K_XMM: case K_BLENDV: case K_PTEST: {
+		if (!is_xmm(o0)) return -1;
+		memcpy(&t.dst, XREG(o0->base - UD_R_XMM0), 16);
+		if (is_xmm(o1)) memcpy(&t.src, XREG(o1->base - UD_R_XMM0), 16);
+		else if (o1->type == UD_OP_MEM) { t.extended = 1; if (opemu_load_mem(op, o1, &t.src.uint128, e->memsz) != 0) return -1; }
+		else return -1;
+		if (e->kind == K_BLENDV) memcpy(&t.xmm0, XREG(0), 16);
+		break;
+	}
+	case K_PINSR: {
+		if (!is_xmm(o0)) return -1;
+		memcpy(&t.dst, XREG(o0->base - UD_R_XMM0), 16);
+		if (o1->type == UD_OP_REG) { if (opemu_gpr_read(op, o1->base, &t.gpr_in) != 0) return -1; }
+		else if (o1->type == UD_OP_MEM) { if (opemu_load_mem(op, o1, &t.gpr_in, e->memsz) != 0) return -1; }
+		else return -1;
+		break;
+	}
+	case K_PEXTR: {
+		if (!is_xmm(o1)) return -1;
+		memcpy(&t.src, XREG(o1->base - UD_R_XMM0), 16);
+		break;
+	}
+	case K_POPCNT: case K_CRC32: {
+		uint64_t v = 0;
+		if (o0->type != UD_OP_REG) return -1;
+		if (o1->type == UD_OP_REG) { if (opemu_gpr_read(op, o1->base, &v) != 0) return -1; t.opsize = o1->size; }
+		else if (o1->type == UD_OP_MEM) { t.opsize = o1->size; if (!t.opsize) return -1; if (opemu_load_mem(op, o1, &v, t.opsize / 8) != 0) return -1; }
+		else return -1;
+		t.gpr_in = v;
+		if (e->kind == K_POPCNT) t.opsize = o0->size;
+		else { uint64_t acc; if (opemu_gpr_read(op, o0->base, &acc) != 0) return -1; t.gpr_out = acc; }
+		break;
+	}
+	}
+
+	e->f(&t);
+
+	switch (e->kind) {
+	case K_XMM: case K_BLENDV: case K_PINSR:
+		memcpy(XREG(o0->base - UD_R_XMM0), &t.res, 16);
+		break;
+	case K_PTEST:
+		apply_flags(op, t.flags_out);
+		break;
+	case K_PEXTR:
+		if (o0->type == UD_OP_REG) { if (opemu_gpr_write(op, o0->base, t.gpr_out) != 0) return -1; }
+		else if (o0->type == UD_OP_MEM) { if (opemu_store_mem(op, o0, &t.gpr_out, e->memsz) != 0) return -1; }
+		else return -1;
+		break;
+	case K_POPCNT:
+		if (opemu_gpr_write(op, o0->base, t.gpr_out) != 0) return -1;
+		apply_flags(op, t.flags_out);
+		break;
+	case K_CRC32:
+		if (opemu_gpr_write(op, o0->base, (uint32_t)t.gpr_out) != 0) return -1;	/* zero-extends */
+		break;
+	}
+	return 0;
+}
